# SMTP email provider
VAANKAN_SMTP_HOST=smtp.gmail.com
VAANKAN_SMTP_PORT=587
VAANKAN_SMTP_USERNAME=your-gmail-address@gmail.com
VAANKAN_SMTP_PASSWORD=your-gmail-app-password
VAANKAN_SMTP_FROM=your-gmail-address@gmail.com

# Twilio SMS provider
VAANKAN_TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VAANKAN_TWILIO_AUTH_TOKEN=your-twilio-auth-token
VAANKAN_TWILIO_FROM=+10000000000

# Optional PostgreSQL/PostGIS persistence. Leave unset for in-memory demo mode.
STORAGE_BACKEND=memory
# Groq AI configuration. Keep the API key on the backend only and do not commit an actual secret.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# For local Compose PostGIS only, change STORAGE_BACKEND to postgres.
# DATABASE_URL=postgresql+psycopg://vaankan:vaankan@localhost:5432/vaankan
# TEST_DATABASE_URL=postgresql+psycopg://vaankan:vaankan@localhost:5433/vaankan_test
# DATABASE_POOL_SIZE=5
# DATABASE_MAX_OVERFLOW=10
# DATABASE_POOL_TIMEOUT=30
