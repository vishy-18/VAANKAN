# SMTP email provider
VAANKAN_SMTP_HOST=smtp.gmail.com
VAANKAN_SMTP_PORT=587
VAANKAN_SMTP_USERNAME=your-gmail-address@gmail.com
VAANKAN_SMTP_PASSWORD=your-gmail-app-password
VAANKAN_SMTP_FROM=your-gmail-address@gmail.com

# Twilio SMS provider
VAANKAN_TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VAANKAN_TWILIO_AUTH_TOKEN=your-twilio-auth-token
VAANKAN_TWILIO_FROM=+10000000000
